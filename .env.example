# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ห้ามอัพขึ้น GitHub)

# Flask
SECRET_KEY=เปลี่ยนเป็นค่าสุ่มยาวๆ-ใช้คำสั่ง-python-secrets-token-hex-32

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=รหัสผ่านฐานข้อมูลจริง
DB_NAME=blur_db
DB_PORT=3306

# ngrok (ใช้เฉพาะตอนทดสอบในเครื่องตัวเอง, ไม่ต้องใช้บน production)
USE_NGROK=false
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=

# Production เท่านั้น (Railway/Render จะตั้งให้อัตโนมัติ ไม่ต้องใส่เอง)
PORT=5000
